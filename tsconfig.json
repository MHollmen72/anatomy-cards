{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "build/app",
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/vendor/**/*.d.ts"]
}
